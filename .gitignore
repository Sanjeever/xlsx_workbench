# Python 虚拟环境
.venv/

# uv 缓存
.uv/

# Python 字节码
__pycache__/
*.py[cod]
*.pyo

# 分析输出（本地生成，不纳入版本控制）
output/*
!output/.gitkeep

# 数据文件（可选：如不希望提交数据则取消注释）
# data/*.xlsx

# Jupyter
.ipynb_checkpoints/
*.ipynb

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 临时脚本（AI 生成的临时文件）
output/_tmp.py
